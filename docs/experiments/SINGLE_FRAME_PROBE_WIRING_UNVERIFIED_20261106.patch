+class SettlementPageProbeTests(unittest.TestCase):
+    @staticmethod
+    def result(state="RETURN_RESULT", *, best_score=0.995, margin=0.12):
+        return FingerprintClassification(
+            state=state,
+            best_state="RETURN_RESULT",
+            best_score=best_score,
+            margin=margin,
+            scores={"RETURN_RESULT": best_score, "BONUS_ITEMS": 0.72, "HOME_PORT": 0.68},
+            minimum_score=0.97,
+            minimum_margin=0.04,
+        )
+
+    def test_settlement_probe_classifies_all_states_from_one_frame(self):
+        screen = ScriptedScreen("RETURN_RESULT")
+        clicks = []
+        calls = []
+        records = []
+        driver = build_driver(
+            screen,
+            clicks,
+            probe_current_state=lambda: (calls.append("frame") or self.result()),
+            event_records=records,
+        )
+
+        self.assertEqual(driver.probe_settlement_page(), "RETURN_RESULT")
+        self.assertEqual(calls, ["frame"])
+        self.assertEqual(screen.verified, [])
+        self.assertEqual(clicks, [])
+        probe_event = next(
+            payload for event, payload in records
+            if event == "continuous_ui_drain_page_probe"
+        )
+        self.assertEqual(probe_event["probe_frames"], 1)
+        self.assertEqual(probe_event["probe_method"], "single_frame_all_state_fingerprint")
+        self.assertEqual(probe_event["best_state"], "RETURN_RESULT")
+        self.assertEqual(probe_event["best_score"], 0.995)
+        self.assertEqual(probe_event["margin"], 0.12)
+        self.assertEqual(probe_event["minimum_score"], 0.97)
+        self.assertEqual(probe_event["minimum_margin"], 0.04)
+
+    def test_unknown_single_frame_probe_never_uses_its_best_candidate_as_proof(self):
+        screen = ScriptedScreen("RETURN_RESULT")
+        clicks = []
+        calls = []
+        driver = build_driver(
+            screen,
+            clicks,
+            probe_current_state=lambda: (
+                calls.append("frame")
+                or self.result("UNKNOWN", best_score=0.9607, margin=0.02)
+            ),
+        )
+
+        self.assertIsNone(driver.probe_settlement_page())
+        self.assertEqual(calls, ["frame"])
+        self.assertEqual(screen.verified, [])
+        self.assertEqual(clicks, [])
+
+    def test_advance_still_requires_two_consecutive_state_evidence_after_probe(self):
+        screen = ScriptedScreen(
+            "RETURN_RESULT", {"RETURN_RESULT": "BONUS_ITEMS"}
+        )
+        clicks = []
+        driver = build_driver(
+            screen,
+            clicks,
+            probe_current_state=lambda: self.result(),
+        )
+
+        self.assertEqual(driver.probe_settlement_page(), "RETURN_RESULT")
+        self.assertEqual(screen.verified, [])
+        driver.advance_settlement_page("RETURN_RESULT")
+
+        self.assertEqual(screen.verified, ["RETURN_RESULT"])
+        self.assertEqual(clicks, [REWARD_ADVANCE])
+        self.assertEqual(screen.state, "BONUS_ITEMS")
+
